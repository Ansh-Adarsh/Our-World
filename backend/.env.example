# ─── BACKEND ENVIRONMENT ──────────────────────────────────────────────────────
# ⚠️ Copy this to .env and fill in real values.
# ⚠️ NEVER commit .env to git. NEVER expose these in frontend code.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT — same secret as your Supabase project's JWT secret
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
JWT_SECRET=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173
