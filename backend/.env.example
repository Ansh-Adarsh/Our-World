# ─── OUR WORLD: BACKEND ENVIRONMENT VARIABLES ────────────────────────────────
# ⚠️ Copy this file to backend/.env and fill in real values.
# ⚠️ NEVER commit backend/.env to git. NEVER expose these values in frontend code.

# 1. Supabase Project Configuration
# Found at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2. JWT Secret — used to verify JWT tokens issued by Supabase Auth
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
JWT_SECRET=

# 3. CORS — comma-separated list of allowed origins (frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173

# 4. AI Engine: Groq LLM (Backend Only)
# ⚠️ GROQ_API_KEY must NEVER appear in frontend code or git history.
# Get your API key from: https://console.groq.com
GROQ_API_KEY=

# Optional model override (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
