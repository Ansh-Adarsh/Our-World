# ─── BACKEND ENVIRONMENT ──────────────────────────────────────────────────────
# ⚠️ Copy this to .env and fill in real values.
# ⚠️ NEVER commit .env to git. NEVER expose these in frontend code.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT — same secret as your Supabase project's JWT secret
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
JWT_SECRET=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── PHASE 4: AI INTEGRATION ─────────────────────────────────────────────────
# ⚠️ GROQ_API_KEY must NEVER appear in frontend code or git history.
# Get your key from: https://console.groq.com
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
